{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::iot-sensor-mvp-frontend-129896631584-us-east-2", "arn:aws:s3:::iot-sensor-mvp-frontend-129896631584-us-east-2/*"],
      "Condition": {"Bool": {"aws:PrincipalIsAWSService": "false", "aws:SecureTransport": "false"}}
    },
    {
      "Sid": "AllowCloudFrontDistributionRead",
      "Effect": "Allow",
      "Principal": {"Service": "cloudfront.amazonaws.com"},
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::iot-sensor-mvp-frontend-129896631584-us-east-2/*",
      "Condition": {"StringEquals": {"AWS:SourceArn": "arn:aws:cloudfront::129896631584:distribution/E1GYZA65O051YD"}}
    }
  ]
}
